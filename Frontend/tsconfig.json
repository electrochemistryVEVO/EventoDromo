{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js", // <-- AÑADIDO: Incluye todos los archivos JavaScript.
    "**/*.jsx", // <-- AÑADIDO: Incluye todos los archivos JSX.
    ".next/types/**/*.ts",
    "../front-edromo/src/components/eventCard.tsx",
    "../front-edromo/src/components/carrusel/globals.ts",
    "../front-edromo/src/components/carrusel/carouselImage.tsx"
  ],
  // --- Archivos a Excluir ---
  "exclude": ["node_modules"]
}
